<Window x:Class="Ytec.WifiCapsule.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Y-TEC Wi-Fi Capsule"
        Width="1120"
        Height="720"
        MinWidth="360"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        Background="{StaticResource WindowBackgroundBrush}"
        AutomationProperties.Name="{DynamicResource MainWindowAutomation}">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,14"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="HeaderLogo"
                            Width="64"
                            Height="64"
                            Margin="0,0,16,0"
                            Background="#0C2A40"
                            BorderBrush="{StaticResource CyanBrush}"
                            BorderThickness="1.5"
                            CornerRadius="17">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15"
                                              Color="#2ADCF5"
                                              Opacity="0.38"
                                              ShadowDepth="0" />
                        </Border.Effect>
                        <Image Margin="2"
                               Source="Assets/app-icon.png"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="24"
                                   FontWeight="Bold"
                                   Text="Y-TEC Wi-Fi Capsule" />
                        <TextBlock x:Name="HeaderSubtitle"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{DynamicResource HeaderSubtitle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel x:Name="HeaderActions"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button Content="{DynamicResource ManualButton}"
                            Click="OpenManual_Click"
                            AutomationProperties.Name="{DynamicResource ManualButtonAutomation}" />
                    <Button Content="{DynamicResource AboutButton}"
                            Click="ShowAbout_Click"
                            AutomationProperties.Name="{DynamicResource AboutButtonAutomation}" />
                    <Button Content="{DynamicResource LanguageSwitch}"
                            Click="SwitchLanguage_Click"
                            AutomationProperties.Name="{DynamicResource LanguageSwitchAutomation}" />
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
            <Border x:Name="TestModeBanner"
                    Padding="12,7"
                    Background="#3B2E10"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{StaticResource WarningBrush}"
                           FontWeight="SemiBold"
                           Text="{DynamicResource TestModeBanner}"
                           TextWrapping="Wrap" />
            </Border>
            <Border x:Name="DevelopmentKeyBanner"
                    Padding="12,7"
                    Background="#3B2E10"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <TextBlock x:Name="DevelopmentKeyBannerText"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource WarningBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <TabControl x:Name="MainTabs"
                    Grid.Row="2"
                    Margin="14,10,14,0"
                    Background="{StaticResource WindowBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="{DynamicResource BackupTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource BackupAdapterHeading}" />
                                <TextBlock Margin="0,4,0,8"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{DynamicResource BackupAdapterDescription}"
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <ComboBox x:Name="BackupAdapterCombo"
                                              Width="430"
                                              MaxWidth="520"
                                              Margin="0,0,10,8"
                                              SelectionChanged="BackupAdapterCombo_SelectionChanged"
                                              AutomationProperties.Name="{DynamicResource BackupAdapterAutomation}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Foreground="#102033"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Foreground="#435A70"
                                                               FontSize="11"
                                                               Text="{Binding Description}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="{DynamicResource RefreshButton}"
                                            Click="RefreshAdapters_Click"
                                            AutomationProperties.Name="{DynamicResource RefreshButtonAutomation}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0">
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="{DynamicResource BackupProfilesHeading}" />
                                        <TextBlock x:Name="BackupSelectionCountText"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{DynamicResource PreparingStatus}" />
                                    </StackPanel>
                                    <WrapPanel x:Name="BackupSelectionActions"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource SelectAllButton}"
                                                Click="SelectAllBackup_Click" />
                                        <Button Content="{DynamicResource ClearSelectionButton}"
                                                Click="ClearBackupSelection_Click" />
                                    </WrapPanel>
                                </Grid>

                                <Border Margin="0,10,0,0"
                                        Background="{StaticResource InsetBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <ListBox x:Name="BackupProfileList"
                                             MinHeight="120"
                                             MaxHeight="180"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="{DynamicResource BackupProfilesAutomation}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Focusable" Value="False" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="12,4"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{Binding Name}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Margin="8,0,12,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource BadgeStyle}">
                                                            <TextBlock Foreground="{StaticResource MintBrush}"
                                                                       FontSize="11"
                                                                       Text="{Binding Detail}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid x:Name="BackupActionGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource BackupActionHeading}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,4,8,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{DynamicResource BackupActionDescription}"
                                           TextWrapping="Wrap" />
                                <Button x:Name="BackupActionButton"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource BackupActionButton}"
                                        Click="CreateBackup_Click"
                                        AutomationProperties.Name="{DynamicResource BackupActionAutomation}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource RestoreTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource OpenBackupHeading}" />
                                <TextBlock Margin="0,5,0,12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{DynamicResource OpenBackupDescription}"
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="{DynamicResource OpenBackupButton}"
                                            Click="OpenBackup_Click"
                                            AutomationProperties.Name="{DynamicResource OpenBackupAutomation}" />
                                    <TextBlock x:Name="OpenedBackupText"
                                               Margin="4,9,0,8"
                                               Foreground="{StaticResource CyanBrush}"
                                               Text="{DynamicResource NotSelected}"
                                               TextTrimming="CharacterEllipsis" />
                                </WrapPanel>
                                <TextBlock x:Name="OpenedBackupSummaryText"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0">
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="{DynamicResource RestoreProfilesHeading}" />
                                        <TextBlock x:Name="RestoreSelectionCountText"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{DynamicResource PreparingStatus}" />
                                    </StackPanel>
                                    <WrapPanel x:Name="RestoreSelectionActions"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource SelectAllButton}"
                                                Click="SelectAllRestore_Click" />
                                        <Button Content="{DynamicResource ClearSelectionButton}"
                                                Click="ClearRestoreSelection_Click" />
                                    </WrapPanel>
                                </Grid>

                                <Border Margin="0,10,0,0"
                                        Background="{StaticResource InsetBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <ListBox x:Name="RestoreProfileList"
                                             MinHeight="120"
                                             MaxHeight="175"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="{DynamicResource RestoreProfilesAutomation}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Focusable" Value="False" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="12,4"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="{Binding Name}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Margin="8,0,12,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource BadgeStyle}">
                                                            <TextBlock Foreground="{StaticResource MintBrush}"
                                                                       FontSize="11"
                                                                       Text="{Binding Detail}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource RestoreSafetyHeading}" />
                                <TextBlock Margin="0,5,0,10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{DynamicResource RestoreSafetyDescription}"
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <ComboBox x:Name="RestoreAdapterCombo"
                                              Width="430"
                                              MaxWidth="520"
                                              Margin="0,0,10,8"
                                              SelectionChanged="RestoreAdapterCombo_SelectionChanged"
                                              AutomationProperties.Name="{DynamicResource RestoreAdapterAutomation}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Foreground="#102033"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Foreground="#435A70"
                                                               FontSize="11"
                                                               Text="{Binding Description}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </WrapPanel>
                                <CheckBox x:Name="OverwriteExistingCheckBox"
                                          Margin="0,2,0,10"
                                          Content="{DynamicResource OverwriteExisting}"
                                          AutomationProperties.HelpText="{DynamicResource OverwriteExistingHelp}" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{DynamicResource RestoreActionButton}"
                                            Click="RestoreProfiles_Click"
                                            AutomationProperties.Name="{DynamicResource RestoreActionAutomation}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Padding="16,10"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{DynamicResource PreparingStatus}"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="BusyProgress"
                                 Height="3"
                                 Margin="0,7,12,0"
                                 Foreground="{StaticResource CyanBrush}"
                                 IsIndeterminate="False"
                                 Visibility="Collapsed" />
                </StackPanel>
                <WrapPanel x:Name="CompactActions"
                           Grid.Column="1"
                           Visibility="Collapsed">
                    <Button Content="{DynamicResource ManualButtonCompact}"
                            Click="OpenManual_Click" />
                    <Button Content="{DynamicResource AboutButtonCompact}"
                            Click="ShowAbout_Click" />
                    <Button Content="{DynamicResource LanguageSwitchCompact}"
                            Click="SwitchLanguage_Click" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
